# Copy to .env on the server and fill in. Never commit .env.
POSTGRES_DB=iet_dashboard
POSTGRES_USER=iet_dashboard
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Microsoft Entra ID app registration (Azure portal → App registrations)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# The admin's Microsoft email. They choose the admin password at first sign-in.
APP_ADMIN_EMAIL=
# true = clear the admin password on next start (forgotten password); set back to false afterwards.
APP_ADMIN_RESET_PASSWORD=false
# Temporary: sign in by email before Microsoft is set up. Keep false in real use.
APP_PREVIEW_SIGNIN=false
APP_EMAIL_DOMAIN=jklu.edu.in
APP_ALLOWED_EMAIL_DOMAINS=jklu.edu.in
# Where people open the app (used in emailed links), e.g. https://your-app.vercel.app
APP_PUBLIC_URL=
APP_COORDINATOR_NAME=Coordinator
APP_INSTITUTION_NAME=Institute of Engineering & Technology

# Outgoing email for reminders (e.g. smtp.office365.com:587 with a service mailbox)
SPRING_MAIL_HOST=smtp.office365.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

HTTP_PORT=80
